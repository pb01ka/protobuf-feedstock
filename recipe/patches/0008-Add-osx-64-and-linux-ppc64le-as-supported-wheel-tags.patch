From 3885275fd6d2ecd2a7b65ff77b3293484da91c40 Mon Sep 17 00:00:00 2001
From: pb01ka <gaganpb08singh@gmail.com>
Date: Thu, 21 May 2026 01:52:32 +0530
Subject: [PATCH] Compatible windows changes

---
 python/dist/BUILD.bazel | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/python/dist/BUILD.bazel b/python/dist/BUILD.bazel
index 9eff63f09..ee672205c 100644
--- a/python/dist/BUILD.bazel
+++ b/python/dist/BUILD.bazel
@@ -69,6 +69,25 @@ config_setting(
     },
 )
 
+config_setting(
+    name = "linux_ppc64le_release",
+    flag_values = {
+        "//toolchain:release": "True",
+    },
+    values = {"cpu": "linux-ppc"},
+)
+
+config_setting(
+    name = "linux_ppc64le_local",
+    constraint_values = [
+        "@platforms//os:linux",
+        "@platforms//cpu:ppc",
+    ],
+    flag_values = {
+        "//toolchain:release": "False",
+    },
+)
+
 config_setting(
     name = "linux_x86_64_release",
     constraint_values = [
@@ -285,6 +304,7 @@ pkg_files(
     srcs = [
         "//:LICENSE",
         "//python:message_srcs",
+        "//python:version_script.lds",
         "//upb:source_files",
         "//upb/base:source_files",
         "//upb/hash:source_files",
@@ -373,11 +393,14 @@ py_wheel(
     platform = select({
         ":linux_x86_64_local": "linux_x86_64",
         ":linux_x86_64_release": "manylinux2014_x86_64",
+        ":linux_ppc64le_local": "linux_ppc64le",
+        ":linux_ppc64le_release": "manylinux2014_ppc64le",
         ":linux_aarch64_local": "linux_aarch64",
         ":linux_aarch64_release": "manylinux2014_aarch64",
         ":linux_s390x_local": "linux_s390x",
         ":linux_s390x_release": "manylinux2014_s390x",
         ":osx_universal2": "macosx_10_9_universal2",
+        ":osx_x86_64": "macosx_10_13_x86_64",
         ":osx_aarch64": "macosx_11_0_arm64",
         ":windows_x86_32": "win32",
         ":windows_x86_64": "win_amd64",
@@ -398,7 +421,6 @@ py_wheel(
         "src/",
     ],
     target_compatible_with = select({
-        "@system_python//:none": ["@platforms//:incompatible"],
         "//conditions:default": [],
     }),
     version = PROTOBUF_PYTHON_VERSION,
